# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Exclude demo project and dev files from `git archive` (e.g. GitHub ZIP downloads).
# Only the addons/ plugin folder will be included in the downloaded archive.
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
LICENSE export-ignore
README.md export-ignore
plugin_icon.png export-ignore
screenshot_1.png export-ignore
screenshot_2.png export-ignore
screenshot_3.png export-ignore
screenshot_4.png export-ignore
screenshot_5.png export-ignore
icon.svg export-ignore
*.import export-ignore
main.gd export-ignore
main.gd.uid export-ignore
main.tscn export-ignore
project.godot export-ignore
